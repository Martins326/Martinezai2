 # Martins AI server
PORT=3000
NODE_ENV=development

# Required for AI chat, research and memory features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: AI image generation/editing
NVIDIA_API_KEY=

# Optional: search real photographs from Unsplash
UNSPLASH_ACCESS_KEY=

# Optional: email verification and password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public application URL
PUBLIC_APP_URL=http://localhost:3000

# False for local HTTP development; true behind HTTPS in production
COOKIE_SECURE=false

# Optional storage locations
MARTINEZAI_AUTH_DIR=./data/auth
MARTINEZAI_DATA_DIR=./data/users
MARTINEZAI_IMAGE_LIBRARY_DIR=./data/image-library
MARTINEZAI_SIMULATION_DIR=./data/simulations